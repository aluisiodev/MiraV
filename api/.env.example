# Copie para .env e preencha. Nunca publique o .env no GitHub.

# PostgreSQL (local com docker compose, ou a URL do Neon em produção)
DATABASE_URL=postgres://mirav:mirav@localhost:5432/mirav?sslmode=disable
PORT=8080

# Endereços do site que podem chamar a API, separados por vírgula
ALLOWED_ORIGINS=http://localhost:3000

# Sal para anonimizar o IP gravado nos formulários (qualquer texto longo e aleatório)
IP_SALT=troque-por-um-texto-aleatorio

# ---- IA (todas gratuitas; basta uma) ----
# Groq: console.groq.com > API Keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Google AI Studio: aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenRouter (opcional): escolha um modelo de visão com sufixo :free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama no notebook da apresentação (plano B sem internet)
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3-vl:8b

# Ordem de tentativa e resultado simulado quando nenhuma IA responder
LLM_ORDER=groq,gemini,openrouter,ollama
DEMO_FALLBACK=true
TRUST_PROXY=true
