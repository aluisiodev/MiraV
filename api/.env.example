# Copie para .env e preencha. Nunca publique o .env no GitHub.

# PostgreSQL (local com docker compose, ou a URL do Neon em produção).
# A URL do Neon pode ser colada como o painel mostra: a API tira sozinha o "channel_binding=require".
DATABASE_URL=postgres://mirav:mirav@localhost:5432/mirav?sslmode=disable
PORT=8080

# Endereços do site que podem chamar a API, separados por vírgula
ALLOWED_ORIGINS=http://localhost:3000

# Sal para anonimizar o IP gravado nos formulários (qualquer texto longo e aleatório)
IP_SALT=troque-por-um-texto-aleatorio

# Atrás do Render (proxy): "true" usa o IP real do visitante para os limites de envio
TRUST_PROXY=true
